# Variáveis do compose de PRODUÇÃO (compose.yaml na raiz).
# Copie para ".env" (nesta mesma pasta) e preencha os valores vazios.
# O .env nunca vai para o git.
#
# As senhas e o JWT_SECRET ficam VAZIOS de propósito: este arquivo é público
# (está no GitHub). Um valor de exemplo aqui poderia ir para produção por
# esquecimento. Vazios, o app nem sobe: o Postgres recusa criar o banco sem
# senha, o create-app-role.ps1 recusa a senha do app e o backend recusa um
# segredo com menos de 32 bytes.

DB_NAME=bicavi
# Administrador do banco (superusuário). Só o container do Postgres e os
# scripts de backup/restauração usam; o backend nunca.
DB_USER=bicavi
# Senha forte e diferente da de desenvolvimento.
# Gere uma no PowerShell:  -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 40 | % {[char]$_})
DB_PASSWORD=

# Usuário com que o BACKEND entra no banco: comum, dono só das tabelas do app.
# Criado por scripts/create-app-role.ps1 (ver DEPLOY.md). Senha diferente da
# do administrador; gere com o mesmo comando acima.
APP_DB_USER=bicavi_app
APP_DB_PASSWORD=

# Assina os tokens de login. Vazou = qualquer um gera tokens válidos.
# No mínimo 32 caracteres; gere com o mesmo comando acima.
JWT_SECRET=

# Porta local do app (só acessível neste computador).
WEB_PORT=8088
