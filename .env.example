# Variáveis do compose de PRODUÇÃO (compose.yaml na raiz).
# Copie para ".env" (nesta mesma pasta) e troque TODOS os valores.
# O .env nunca vai para o git.

DB_NAME=bicavi
DB_USER=bicavi
# Senha forte e diferente da de desenvolvimento.
# Gere uma no PowerShell:  -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 40 | % {[char]$_})
DB_PASSWORD=troque-esta-senha

# Assina os tokens de login. Vazou = qualquer um gera tokens válidos.
# No mínimo 32 caracteres; gere com o mesmo comando acima.
JWT_SECRET=troque-este-segredo-com-pelo-menos-32-caracteres

# Porta local do app (só acessível neste computador).
WEB_PORT=8088
